{
  "name": "quickinspect",
  "version": "1.1.1",
  "description": "Hold Alt and hover any element to see its selectors, box model, styles, accessibility info and events without opening DevTools.",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "pnpm build:bridge && vite",
    "build": "tsc && pnpm build:bridge && vite build",
    "lint": "pnpm exec eslint .",
    "typecheck": "pnpm exec tsc",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "build:bridge": "vite build -c vite.bridge.config.ts",
    "test": "pnpm exec jest",
    "test:watch": "pnpm exec jest --watch",
    "test:coverage": "pnpm exec jest --coverage"
  },
  "author": "Konstantine Datunishvili <konstantineda@datunishvili.ge>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@kostad/brand": "^1.5.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/chrome": "^0.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-chrome": "^0.8.0",
    "jest-environment-jsdom": "^30.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "sass": "1.105.1",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "pnpm format:check",
        "pnpm lint",
        "pnpm test"
      ],
      "after:bump": "pnpm build"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "docs",
              "section": "Documentations"
            },
            {
              "type": "refactor",
              "section": "Refactors"
            }
          ]
        }
      }
    }
  }
}

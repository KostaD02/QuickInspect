{
  "name": "QuickInspect",
  "version": "0.1.0",
  "description": "Hold Alt and hover any element to see its selectors, box model, styles, accessibility info and events without opening DevTools.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm exec eslint .",
    "typecheck": "pnpm exec tsc",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check ."
  },
  "keywords": [],
  "author": "Konstantine Datunishvili <konstantineda@datunishvili.ge>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}

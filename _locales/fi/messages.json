  "infoIntro": {
    "message": "QuickInspect näyttää, mitä elementistä pitää tietää, avaamatta DevToolsia: <strong>valitsimet</strong>, <strong>laatikkomallin</strong>, <strong>lasketut tyylit</strong>, <strong>saavutettavuuden</strong>, <strong>attribuutit</strong>, <strong>tapahtumat</strong> ja <strong>lähdetiedoston</strong>, josta se tulee."
  },
  "infoStep1": {
    "message": "Pidä <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> pohjassa ja osoita elementtiä tarkastellaksesi sitä; vapauta palauttaaksesi sivun. Valitse toinen näppäin päänäkymän kohdasta <strong>Pohjassa pidettävä näppäin</strong>."
  },
  "infoStep2": {
    "message": "<strong>Klikkaa</strong> näppäintä pitäen kiinnittääksesi paneelin ja siirrä sitä sitten otsikosta vetämällä. <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> siirtyvät vanhempaan tai lapseen, <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> sisarelementteihin."
  },
  "infoStep3": {
    "message": "Paina <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> kopioidaksesi valitsimen, XPathin, Playwright-paikantimen, HTML:n tai tekstin."
  },
  "infoScreenshot": {
    "message": "Paina <kbd class=\"kd-chip kd-font-mono\">C</kbd> ottaaksesi kuvakaappauksen elementistä. Se ladataan PNG-tiedostona tai kopioidaan leikepöydälle; vaihda asetuksista kohdasta <strong>Lataa kuvakaappaukset</strong>."
  },
  "infoCompare": {
    "message": "Paina <kbd class=\"kd-chip kd-font-mono\">D</kbd> elementin kohdalla ja vie sitten osoitin toisen päälle tai kiinnitä se nähdäksesi, missä laatikko ja tyylit eroavat. Lopeta painamalla <kbd class=\"kd-chip kd-font-mono\">D</kbd> uudelleen ensimmäisen kohdalla. Kiinnitetyssä paneelissa voit siirtyä esivanhempaan napsauttamalla sitä kohdassa <strong>Konteksti</strong>."
  },
  "infoStep4": {
    "message": "Kiinnitetyssä paneelissa <strong>klikkaa mitä tahansa arvoa</strong> muokataksesi tyylejä, laatikkoa, attribuutteja tai tekstiä. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> ottaa käyttöön, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> peruu ja <strong>reset</strong> kumoaa kaiken. Muokkaukset säilyvät sivulla uudelleenlataukseen asti."
  },
  "infoPersist": {
    "message": "Ota asetuksista käyttöön <strong>Säilytä muokkaukset</strong>, niin muokkaukset palautuvat, kun sivu latautuu. <strong>css</strong> kiinnitetyssä paneelissa kopioi kaikki sivun muokkaukset CSS:nä."
  },
  "infoStep5": {
    "message": "<strong>Vite</strong>- tai <strong>Next.js</strong>-kehityspalvelimella paina <kbd class=\"kd-chip kd-font-mono\">O</kbd> avataksesi elementin lähteen editorissa."
  },

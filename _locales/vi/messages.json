  "infoIntro": {
    "message": "QuickInspect cho bạn thấy những gì cần biết về bất kỳ phần tử nào mà không cần mở DevTools: <strong>bộ chọn</strong>, <strong>box model</strong>, <strong>kiểu đã tính</strong>, <strong>khả năng tiếp cận</strong>, <strong>thuộc tính</strong>, <strong>sự kiện</strong> và <strong>tệp nguồn</strong> của nó."
  },
  "infoStep1": {
    "message": "Giữ <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> và di chuột lên một phần tử để kiểm tra, thả ra để trang trở lại như cũ. Chọn phím khác trong <strong>Phím giữ</strong> ở màn hình chính."
  },
  "infoStep2": {
    "message": "<strong>Nhấp</strong> trong khi giữ để ghim bảng, rồi kéo phần đầu để di chuyển. Dùng <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> cho cha hoặc con và <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> cho các phần tử anh em."
  },
  "infoStep3": {
    "message": "Nhấn <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> để sao chép bộ chọn, XPath, locator Playwright, HTML hoặc văn bản."
  },
  "infoStep4": {
    "message": "Trong bảng đã ghim, <strong>nhấp vào bất kỳ giá trị nào</strong> để chỉnh sửa kiểu, box, thuộc tính hoặc văn bản. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> áp dụng, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> hủy và <strong>reset</strong> hoàn tác tất cả. Các chỉnh sửa giữ nguyên trên trang cho đến khi tải lại."
  },
  "infoStep5": {
    "message": "Trên máy chủ dev <strong>Vite</strong> hoặc <strong>Next.js</strong>, nhấn <kbd class=\"kd-chip kd-font-mono\">O</kbd> để mở nguồn của phần tử trong trình soạn thảo của bạn."
  },

  "infoIntro": {
    "message": "QuickInspect viser det du trenger å vite om et element uten å åpne DevTools: <strong>selektorer</strong>, <strong>boksmodellen</strong>, <strong>beregnede stiler</strong>, <strong>tilgjengelighet</strong>, <strong>attributter</strong>, <strong>events</strong> og <strong>kildefilen</strong> det kommer fra."
  },
  "infoStep1": {
    "message": "Hold <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> nede og pek på et element for å inspisere det; slipp for å gjenopprette siden. Velg en annen tast under <strong>Holdetast</strong> på hovedskjermen."
  },
  "infoStep2": {
    "message": "<strong>Klikk</strong> mens du holder for å feste panelet, og dra det deretter i toppen. Bruk <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> for forelder eller barn og <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> for søsken."
  },
  "infoStep3": {
    "message": "Trykk <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> for å kopiere selektoren, XPath, Playwright-locatoren, HTML eller teksten."
  },
  "infoStep4": {
    "message": "I et festet panel kan du <strong>klikke på en verdi</strong> for å redigere stiler, boks, attributter eller tekst. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> bruker, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> avbryter og <strong>reset</strong> angrer alt. Endringene blir på siden til du laster inn på nytt."
  },
  "infoStep5": {
    "message": "På en <strong>Vite</strong>- eller <strong>Next.js</strong>-devserver trykker du <kbd class=\"kd-chip kd-font-mono\">O</kbd> for å åpne elementets kilde i editoren din."
  },

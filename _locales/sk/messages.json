  "infoIntro": {
    "message": "QuickInspect ukáže, čo o prvku potrebujete vedieť, bez otvárania DevTools: <strong>selektory</strong>, <strong>box model</strong>, <strong>vypočítané štýly</strong>, <strong>prístupnosť</strong>, <strong>atribúty</strong>, <strong>udalosti</strong> a <strong>zdrojový súbor</strong>, z ktorého pochádza."
  },
  "infoStep1": {
    "message": "Podržte <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> a prejdite na prvok, ktorý chcete preskúmať; uvoľnením vrátite stránku. Iný kláves vyberiete v poli <strong>Podržaný kláves</strong> na hlavnej obrazovke."
  },
  "infoStep2": {
    "message": "<strong>Kliknutím</strong> pri podržaní panel pripnete a potom ho presuniete za záhlavie. <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> prejdú na rodiča alebo potomka, <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> na súrodencov."
  },
  "infoStep3": {
    "message": "Stlačením <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> skopírujete selektor, XPath, lokátor Playwright, HTML alebo text."
  },
  "infoScreenshot": {
    "message": "Stlačte <kbd class=\"kd-chip kd-font-mono\">C</kbd> pre snímku prvku. Stiahne sa ako PNG alebo sa skopíruje do schránky; prepnete to voľbou <strong>Sťahovať snímky</strong> v nastaveniach."
  },
  "infoCompare": {
    "message": "Stlačte <kbd class=\"kd-chip kd-font-mono\">D</kbd> na prvku, potom prejdite na iný alebo ho pripnite a uvidíte, kde sa líši box a štýly. Ďalším stlačením <kbd class=\"kd-chip kd-font-mono\">D</kbd> na prvom porovnanie ukončíte. V pripnutom paneli kliknite na predka v sekcii <strong>Kontext</strong> a prejdete naň."
  },
  "infoStep4": {
    "message": "V pripnutom paneli <strong>kliknite na ľubovoľnú hodnotu</strong> a upravte štýly, box, atribúty alebo text. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> potvrdí, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> zruší a <strong>reset</strong> vráti všetko späť. Úpravy zostanú na stránke do jej obnovenia."
  },
  "infoStep5": {
    "message": "Na dev serveri <strong>Vite</strong> alebo <strong>Next.js</strong> stlačte <kbd class=\"kd-chip kd-font-mono\">O</kbd> a otvorte zdroj prvku v editore."
  },

  "infoIntro": {
    "message": "QuickInspect pokazuje što trebate znati o bilo kojem elementu bez otvaranja DevToolsa: <strong>selektore</strong>, <strong>box model</strong>, <strong>izračunate stilove</strong>, <strong>pristupačnost</strong>, <strong>atribute</strong>, <strong>događaje</strong> i <strong>izvornu datoteku</strong> iz koje potječe."
  },
  "infoStep1": {
    "message": "Držite <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> i prijeđite mišem preko elementa da ga pregledate; otpustite da vratite stranicu. Drugu tipku odaberite pod <strong>Tipka za držanje</strong> na glavnom zaslonu."
  },
  "infoStep2": {
    "message": "<strong>Kliknite</strong> dok držite tipku da prikvačite ploču, a zatim je povucite za zaglavlje. <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> vode na roditelja ili dijete, <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> na susjedne elemente."
  },
  "infoStep3": {
    "message": "Pritisnite <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> da kopirate selektor, XPath, Playwright lokator, HTML ili tekst."
  },
  "infoStep4": {
    "message": "U prikvačenoj ploči <strong>kliknite bilo koju vrijednost</strong> da uredite stilove, box, atribute ili tekst. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> primjenjuje, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> odustaje, a <strong>reset</strong> poništava sve. Izmjene ostaju na stranici do ponovnog učitavanja."
  },
  "infoStep5": {
    "message": "Na <strong>Vite</strong> ili <strong>Next.js</strong> dev poslužitelju pritisnite <kbd class=\"kd-chip kd-font-mono\">O</kbd> da otvorite izvor elementa u uređivaču."
  },

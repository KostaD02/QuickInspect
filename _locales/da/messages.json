  "infoIntro": {
    "message": "QuickInspect viser, hvad du skal vide om et element, uden at åbne DevTools: <strong>selektorer</strong>, <strong>boksmodellen</strong>, <strong>beregnede stilarter</strong>, <strong>tilgængelighed</strong>, <strong>attributter</strong>, <strong>events</strong> og den <strong>kildefil</strong>, det kommer fra."
  },
  "infoStep1": {
    "message": "Hold <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> nede og peg på et element for at inspicere det; slip for at gendanne siden. Vælg en anden tast under <strong>Holdetast</strong> på hovedskærmen."
  },
  "infoStep2": {
    "message": "<strong>Klik</strong>, mens du holder, for at fastgøre panelet, og træk det derefter i hovedet. Brug <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> til forælder eller barn og <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> til søskende."
  },
  "infoStep3": {
    "message": "Tryk på <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> for at kopiere selektoren, XPath, Playwright-locatoren, HTML eller teksten."
  },
  "infoScreenshot": {
    "message": "Tryk på <kbd class=\"kd-chip kd-font-mono\">C</kbd> for et skærmbillede af elementet. Det downloades som PNG eller kopieres til udklipsholderen; skift under <strong>Download skærmbilleder</strong> i indstillingerne."
  },
  "infoCompare": {
    "message": "Tryk på <kbd class=\"kd-chip kd-font-mono\">D</kbd> på et element, og hold derefter over eller fastgør et andet for at se, hvor boks og styles er forskellige. Tryk på <kbd class=\"kd-chip kd-font-mono\">D</kbd> på det første igen for at stoppe. I et fastgjort panel kan du klikke på en forælder under <strong>Kontekst</strong> for at gå til den."
  },
  "infoStep4": {
    "message": "I et fastgjort panel kan du <strong>klikke på en værdi</strong> for at redigere stilarter, boks, attributter eller tekst. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> anvender, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> annullerer, og <strong>reset</strong> fortryder det hele. Ændringerne bliver på siden, indtil du genindlæser."
  },
  "infoPersist": {
    "message": "Slå <strong>Behold ændringer</strong> til i indstillingerne for at anvende dine ændringer igen, når siden indlæses. <strong>css</strong> i et fastgjort panel kopierer alle ændringer på siden som CSS."
  },
  "infoStep5": {
    "message": "På en <strong>Vite</strong>- eller <strong>Next.js</strong>-devserver kan du trykke på <kbd class=\"kd-chip kd-font-mono\">O</kbd> for at åbne elementets kilde i din editor."
  },

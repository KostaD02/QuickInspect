  "infoIntro": {
    "message": "QuickInspect menunjukkan perkara yang anda perlu tahu tentang mana-mana elemen tanpa membuka DevTools: <strong>pemilih</strong>, <strong>box model</strong>, <strong>gaya terhitung</strong>, <strong>kebolehcapaian</strong>, <strong>atribut</strong>, <strong>event</strong> dan <strong>fail sumber</strong> asalnya."
  },
  "infoStep1": {
    "message": "Tahan <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> dan tuding pada elemen untuk memeriksanya; lepaskan untuk memulihkan halaman. Pilih kekunci lain di bawah <strong>Kekunci tahan</strong> pada skrin utama."
  },
  "infoStep2": {
    "message": "<strong>Klik</strong> semasa menahan untuk menyemat panel, kemudian seret pengepalanya untuk mengalihkannya. Gunakan <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> untuk induk atau anak dan <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> untuk adik-beradik."
  },
  "infoStep3": {
    "message": "Tekan <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> untuk menyalin pemilih, XPath, locator Playwright, HTML atau teks."
  },
  "infoStep4": {
    "message": "Dalam panel yang disemat, <strong>klik mana-mana nilai</strong> untuk menyunting gaya, box, atribut atau teks. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> menggunakan, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> membatalkan dan <strong>reset</strong> membuat asal semuanya. Suntingan kekal pada halaman sehingga dimuat semula."
  },
  "infoStep5": {
    "message": "Pada pelayan dev <strong>Vite</strong> atau <strong>Next.js</strong>, tekan <kbd class=\"kd-chip kd-font-mono\">O</kbd> untuk membuka sumber elemen dalam editor anda."
  },

  "infoIntro": {
    "message": "QuickInspect, DevTools açmadan bir öğe hakkında bilmeniz gerekenleri gösterir: <strong>seçiciler</strong>, <strong>kutu modeli</strong>, <strong>hesaplanmış stiller</strong>, <strong>erişilebilirlik</strong>, <strong>öznitelikler</strong>, <strong>olaylar</strong> ve geldiği <strong>kaynak dosya</strong>."
  },
  "infoStep1": {
    "message": "<kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> tuşunu basılı tutup bir öğenin üzerine gelerek inceleyin; bırakınca sayfa eski haline döner. Ana ekrandaki <strong>Basılı tutulacak tuş</strong> alanından farklı bir tuş seçin."
  },
  "infoStep2": {
    "message": "Basılı tutarken <strong>tıklayarak</strong> paneli sabitleyin, sonra başlığından sürükleyerek taşıyın. <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> üst veya alt öğeye, <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> kardeş öğelere gider."
  },
  "infoStep3": {
    "message": "Seçiciyi, XPath’i, Playwright locator’ı, HTML’yi veya metni kopyalamak için <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> tuşlarına basın."
  },
  "infoStep4": {
    "message": "Sabitlenmiş bir panelde stilleri, kutuyu, öznitelikleri veya metni düzenlemek için <strong>herhangi bir değere tıklayın</strong>. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> uygular, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> iptal eder, <strong>reset</strong> hepsini geri alır. Düzenlemeler sayfa yenilenene kadar kalır."
  },
  "infoStep5": {
    "message": "<strong>Vite</strong> veya <strong>Next.js</strong> geliştirme sunucusunda <kbd class=\"kd-chip kd-font-mono\">O</kbd> tuşuna basarak öğenin kaynağını düzenleyicinizde açın."
  },

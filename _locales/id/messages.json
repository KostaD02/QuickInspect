  "infoIntro": {
    "message": "QuickInspect menampilkan yang perlu Anda ketahui tentang elemen apa pun tanpa membuka DevTools: <strong>selector</strong>, <strong>box model</strong>, <strong>gaya terhitung</strong>, <strong>aksesibilitas</strong>, <strong>atribut</strong>, <strong>event</strong>, dan <strong>file sumber</strong> asalnya."
  },
  "infoStep1": {
    "message": "Tahan <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> dan arahkan kursor ke elemen untuk memeriksanya; lepaskan untuk mengembalikan halaman. Pilih tombol lain di <strong>Tombol tahan</strong> pada layar utama."
  },
  "infoStep2": {
    "message": "<strong>Klik</strong> sambil menahan untuk menyematkan panel, lalu seret header-nya untuk memindahkannya. Gunakan <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> untuk induk atau anak dan <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> untuk saudara."
  },
  "infoStep3": {
    "message": "Tekan <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> untuk menyalin selector, XPath, locator Playwright, HTML, atau teks."
  },
  "infoStep4": {
    "message": "Di panel yang disematkan, <strong>klik nilai mana pun</strong> untuk menyunting gaya, box, atribut, atau teks. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> menerapkan, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> membatalkan, dan <strong>reset</strong> mengembalikan semuanya. Perubahan tetap ada di halaman sampai dimuat ulang."
  },
  "infoStep5": {
    "message": "Di dev server <strong>Vite</strong> atau <strong>Next.js</strong>, tekan <kbd class=\"kd-chip kd-font-mono\">O</kbd> untuk membuka sumber elemen di editor Anda."
  },

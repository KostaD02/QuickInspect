  "infoIntro": {
    "message": "QuickInspect pokazuje, co trzeba wiedzieć o dowolnym elemencie bez otwierania DevTools: <strong>selektory</strong>, <strong>box model</strong>, <strong>obliczone style</strong>, <strong>dostępność</strong>, <strong>atrybuty</strong>, <strong>zdarzenia</strong> i <strong>plik źródłowy</strong>, z którego pochodzi."
  },
  "infoStep1": {
    "message": "Przytrzymaj <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> i najedź na element, aby go zbadać; puść, aby przywrócić stronę. Inny klawisz wybierzesz w sekcji <strong>Przytrzymywany klawisz</strong> na ekranie głównym."
  },
  "infoStep2": {
    "message": "<strong>Kliknij</strong> podczas przytrzymywania, aby przypiąć panel, a potem przeciągnij go za nagłówek. <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> przechodzą do rodzica lub dziecka, <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> do sąsiednich elementów."
  },
  "infoStep3": {
    "message": "Naciśnij <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd>, aby skopiować selektor, XPath, lokator Playwright, HTML lub tekst."
  },
  "infoStep4": {
    "message": "W przypiętym panelu <strong>kliknij dowolną wartość</strong>, aby edytować style, box, atrybuty lub tekst. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> zatwierdza, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> anuluje, a <strong>reset</strong> cofa wszystko. Zmiany zostają na stronie do jej przeładowania."
  },
  "infoStep5": {
    "message": "Na serwerze deweloperskim <strong>Vite</strong> lub <strong>Next.js</strong> naciśnij <kbd class=\"kd-chip kd-font-mono\">O</kbd>, aby otworzyć źródło elementu w edytorze."
  },

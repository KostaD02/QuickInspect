  "infoIntro": {
    "message": "QuickInspect किसी भी एलिमेंट के बारे में ज़रूरी जानकारी DevTools खोले बिना दिखाता है: <strong>सेलेक्टर</strong>, <strong>बॉक्स मॉडल</strong>, <strong>कंप्यूटेड स्टाइल</strong>, <strong>एक्सेसिबिलिटी</strong>, <strong>एट्रिब्यूट</strong>, <strong>इवेंट</strong> और वह <strong>सोर्स फ़ाइल</strong> जहाँ से यह आया।"
  },
  "infoStep1": {
    "message": "<kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> दबाए रखें और किसी एलिमेंट पर होवर करके उसे जाँचें; छोड़ने पर पेज पहले जैसा हो जाता है। मुख्य स्क्रीन पर <strong>दबाए रखने वाली कुंजी</strong> में दूसरी कुंजी चुनें।"
  },
  "infoStep2": {
    "message": "दबाए रखते हुए <strong>क्लिक</strong> करके पैनल पिन करें, फिर उसके हेडर से खींचकर हिलाएँ। पैरेंट या चाइल्ड के लिए <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> और सिबलिंग के लिए <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> इस्तेमाल करें।"
  },
  "infoStep3": {
    "message": "सेलेक्टर, XPath, Playwright लोकेटर, HTML या टेक्स्ट कॉपी करने के लिए <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd> दबाएँ।"
  },
  "infoScreenshot": {
    "message": "एलिमेंट का स्क्रीनशॉट लेने के लिए <kbd class=\"kd-chip kd-font-mono\">C</kbd> दबाएँ। यह PNG के रूप में डाउनलोड होता है या क्लिपबोर्ड पर जाता है; सेटिंग्स में <strong>स्क्रीनशॉट डाउनलोड करें</strong> से बदलें।"
  },
  "infoCompare": {
    "message": "किसी एलिमेंट पर <kbd class=\"kd-chip kd-font-mono\">D</kbd> दबाएँ, फिर दूसरे पर होवर करें या उसे पिन करें, ताकि बॉक्स और स्टाइल का अंतर दिखे। रोकने के लिए पहले पर फिर से <kbd class=\"kd-chip kd-font-mono\">D</kbd> दबाएँ। पिन किए पैनल में <strong>संदर्भ</strong> के अंदर किसी पूर्वज पर क्लिक करके उस पर जाएँ।"
  },
  "infoStep4": {
    "message": "पिन किए गए पैनल में <strong>किसी भी वैल्यू पर क्लिक</strong> करके स्टाइल, बॉक्स, एट्रिब्यूट या टेक्स्ट संपादित करें। <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> लागू करता है, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> रद्द करता है और <strong>reset</strong> सब वापस कर देता है। बदलाव पेज रीलोड होने तक रहते हैं।"
  },
  "infoStep5": {
    "message": "<strong>Vite</strong> या <strong>Next.js</strong> डेव सर्वर पर <kbd class=\"kd-chip kd-font-mono\">O</kbd> दबाकर एलिमेंट का सोर्स अपने एडिटर में खोलें।"
  },

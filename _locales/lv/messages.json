  "infoIntro": {
    "message": "QuickInspect parāda, kas jāzina par jebkuru elementu, neatverot DevTools: <strong>selektorus</strong>, <strong>box modeli</strong>, <strong>aprēķinātos stilus</strong>, <strong>pieejamību</strong>, <strong>atribūtus</strong>, <strong>notikumus</strong> un <strong>avota failu</strong>, no kura tas nācis."
  },
  "infoStep1": {
    "message": "Turiet <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> un norādiet uz elementu, lai to pārbaudītu; atlaidiet, lai atjaunotu lapu. Citu taustiņu izvēlieties galvenā ekrāna laukā <strong>Turamais taustiņš</strong>."
  },
  "infoStep2": {
    "message": "<strong>Noklikšķiniet</strong>, turot taustiņu, lai piespraustu paneli, pēc tam velciet to aiz galvenes. <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> pāriet uz vecāku vai bērnu, <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> uz blakuselementiem."
  },
  "infoStep3": {
    "message": "Nospiediet <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd>, lai kopētu selektoru, XPath, Playwright lokatoru, HTML vai tekstu."
  },
  "infoStep4": {
    "message": "Piespraustā panelī <strong>noklikšķiniet uz jebkuras vērtības</strong>, lai rediģētu stilus, box, atribūtus vai tekstu. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> piemēro, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> atceļ, bet <strong>reset</strong> atsauc visu. Labojumi lapā paliek līdz pārlādēšanai."
  },
  "infoStep5": {
    "message": "<strong>Vite</strong> vai <strong>Next.js</strong> izstrādes serverī nospiediet <kbd class=\"kd-chip kd-font-mono\">O</kbd>, lai atvērtu elementa avotu redaktorā."
  },

  "infoIntro": {
    "message": "QuickInspect parodo, ką reikia žinoti apie bet kurį elementą, neatidarius DevTools: <strong>selektorius</strong>, <strong>box modelį</strong>, <strong>apskaičiuotus stilius</strong>, <strong>prieinamumą</strong>, <strong>atributus</strong>, <strong>įvykius</strong> ir <strong>šaltinio failą</strong>, iš kurio jis kilęs."
  },
  "infoStep1": {
    "message": "Laikykite <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> ir užveskite ant elemento, kad jį patikrintumėte; atleiskite, kad grąžintumėte puslapį. Kitą klavišą pasirinkite pagrindinio ekrano lauke <strong>Laikomas klavišas</strong>."
  },
  "infoStep2": {
    "message": "<strong>Spustelėkite</strong> laikydami klavišą, kad prisegtumėte skydelį, tada vilkite jį už antraštės. <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> pereina į tėvą arba vaiką, <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> į gretimus elementus."
  },
  "infoStep3": {
    "message": "Paspauskite <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd>, kad nukopijuotumėte selektorių, XPath, Playwright lokatorių, HTML arba tekstą."
  },
  "infoScreenshot": {
    "message": "Paspauskite <kbd class=\"kd-chip kd-font-mono\">C</kbd>, kad padarytumėte elemento ekrano kopiją. Ji atsisiunčiama kaip PNG arba nukopijuojama į iškarpinę; perjunkite nustatymuose <strong>Atsisiųsti ekrano kopijas</strong>."
  },
  "infoStep4": {
    "message": "Prisegtame skydelyje <strong>spustelėkite bet kurią reikšmę</strong>, kad redaguotumėte stilius, box, atributus arba tekstą. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> pritaiko, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> atšaukia, o <strong>reset</strong> viską anuliuoja. Pakeitimai puslapyje lieka iki perkrovimo."
  },
  "infoStep5": {
    "message": "<strong>Vite</strong> arba <strong>Next.js</strong> kūrimo serveryje paspauskite <kbd class=\"kd-chip kd-font-mono\">O</kbd>, kad atidarytumėte elemento šaltinį redaktoriuje."
  },

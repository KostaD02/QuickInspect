  "infoIntro": {
    "message": "QuickInspect pokaže, kar morate vedeti o kateremkoli elementu, brez odpiranja DevTools: <strong>selektorje</strong>, <strong>box model</strong>, <strong>izračunane sloge</strong>, <strong>dostopnost</strong>, <strong>atribute</strong>, <strong>dogodke</strong> in <strong>izvorno datoteko</strong>, iz katere izhaja."
  },
  "infoStep1": {
    "message": "Držite <kbd id=\"info-modifier\" class=\"kd-chip kd-font-mono\"></kbd> in se z miško premaknite na element, da ga pregledate; spustite, da povrnete stran. Drugo tipko izberite pod <strong>Tipka za držanje</strong> na glavnem zaslonu."
  },
  "infoStep2": {
    "message": "<strong>Kliknite</strong> med držanjem, da ploščo pripnete, nato jo povlecite za glavo. <kbd class=\"kd-chip kd-font-mono\">↑</kbd> <kbd class=\"kd-chip kd-font-mono\">↓</kbd> vodita k staršu ali otroku, <kbd class=\"kd-chip kd-font-mono\">←</kbd> <kbd class=\"kd-chip kd-font-mono\">→</kbd> k sosednjim elementom."
  },
  "infoStep3": {
    "message": "Pritisnite <kbd class=\"kd-chip kd-font-mono\">S</kbd> <kbd class=\"kd-chip kd-font-mono\">X</kbd> <kbd class=\"kd-chip kd-font-mono\">L</kbd> <kbd class=\"kd-chip kd-font-mono\">H</kbd> <kbd class=\"kd-chip kd-font-mono\">T</kbd>, da kopirate selektor, XPath, lokator Playwright, HTML ali besedilo."
  },
  "infoScreenshot": {
    "message": "Pritisnite <kbd class=\"kd-chip kd-font-mono\">C</kbd> za posnetek elementa. Prenese se kot PNG ali kopira v odložišče; preklopite z možnostjo <strong>Prenašaj posnetke</strong> v nastavitvah."
  },
  "infoStep4": {
    "message": "V pripeti plošči <strong>kliknite katerokoli vrednost</strong>, da uredite sloge, box, atribute ali besedilo. <kbd class=\"kd-chip kd-font-mono\">Enter</kbd> uveljavi, <kbd class=\"kd-chip kd-font-mono\">Esc</kbd> prekliče, <strong>reset</strong> pa razveljavi vse. Spremembe ostanejo na strani do ponovnega nalaganja."
  },
  "infoStep5": {
    "message": "Na razvojnem strežniku <strong>Vite</strong> ali <strong>Next.js</strong> pritisnite <kbd class=\"kd-chip kd-font-mono\">O</kbd>, da odprete vir elementa v urejevalniku."
  },
